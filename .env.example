# Control Plane — environment variables
# Copy to .env and fill in values

# Required
# DATABASE_URL and LISTEN_ADDR are not listed here: docker compose builds them
# from POSTGRES_PASSWORD, BIND_ADDR and HOST_PORT below. Running the binary
# directly requires setting DATABASE_URL yourself, and LISTEN_ADDR if the
# default 127.0.0.1:8080 does not suit.
API_TOKEN=your-api-token
ENCRYPTION_KEY=your-64-char-hex-key
JWT_SECRET=your-64-char-hex-key
POSTGRES_PASSWORD=your-db-password

# First-time WebAuthn setup (set a random secret, use in X-Setup-Token header, then remove)
SETUP_TOKEN=

# Registration gate (if set, POST /auth/register requires X-Registration-Token header)
REGISTRATION_TOKEN=

# Server binding (default: 127.0.0.1, set to 10.10.0.1 for WireGuard)
BIND_ADDR=127.0.0.1
HOST_PORT=8080

# Optional
# Log level: debug, info, warn or error (default: info).
LOG_LEVEL=info
# Marks session cookies Secure, so browsers only send them over HTTPS.
# Leave false for plain-HTTP local development (default: false).
COOKIE_SECURE=false
CORS_ORIGINS=http://localhost:5173
WEBAUTHN_RPID=localhost
WEBAUTHN_ORIGIN=http://localhost:8080

# Background loops (optional)
# How often station status is polled (default: 10s).
POLLER_INTERVAL=10s
# How often expired tokens and stale login-limiter entries are swept
# (default: 1h).
AUTH_JANITOR_INTERVAL=1h

# LXC provisioning over SSH (optional)
# Private key used for pct exec on Proxmox nodes. Mount it into the container;
# the service disables provisioning if it is missing or unreadable
# (default: /root/.ssh/id_ed25519).
SSH_KEY_PATH=/root/.ssh/id_ed25519

# Tenant dashboard SSO links (optional)
# Domain and scheme used to build the per-tenant SSO URL
# (defaults: example.com, https).
SSO_DOMAIN=example.com
SSO_SCHEME=https

# Stripe billing (optional)
# Billing endpoints return 501 until STRIPE_SECRET_KEY is set. The webhook
# secret verifies incoming events; without it every delivery is rejected.
# The three price IDs map a tier to a Stripe price; a tier with no price
# configured cannot be purchased.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER=
STRIPE_PRICE_PRO=
STRIPE_PRICE_STUDIO=

# WireGuard mesh (optional)
WG_HUB_PUBLIC_KEY=
WG_HUB_ENDPOINT=
WG_NETWORK_CIDR=10.10.0.0/24

# Caddy dynamic routing (optional)
CADDY_ADMIN_URL=
CADDY_SERVER_NAME=srv1
CADDY_DOMAIN=example.com

# freeRadio auto-deploy (optional)
# Empty URL keeps the legacy behaviour: the container is expected to already
# hold a freeRadio checkout and only DASHBOARD_TOKEN is written into it.
FREERADIO_REPO_URL=
FREERADIO_REPO_BRANCH=dev

# Topology (optional)
# Every value below defaults to what the code used to hardcode, so leaving them
# unset behaves exactly as before. They exist so a deployment on different
# infrastructure does not need code changes.
LXC_BRIDGE=vmbr0
TENANT_MOUNT_ROOT=/mnt/tenants
TENANT_APP_DIR=/root/freeRadio
CADDY_UPSTREAM_PORT=80
SSH_USER=root
SSH_PORT=22
WG_INTERFACE=wg0
WG_DNS_ADDR=10.10.0.1
WG_KEEPALIVE_SECONDS=25
